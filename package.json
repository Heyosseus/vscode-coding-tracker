{
  "name": "vscode-coding-tracker",
  "displayName": "Coding Tracker",
  "description": "A VS Code extension that tracks coding session time and syncs with a Laravel API.",
  "publisher": "Rati Rukhadze",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:vscode-coding-tracker.startTracking"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "version": "0.0.1",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-coding-tracker.showStats",
        "title": "Show Coding Statistics",
        "category": "Coding Tracker"
      },
      {
        "command": "vscode-coding-tracker.resetStats",
        "title": "Reset Local Statistics",
        "category": "Coding Tracker"
      },
      {
        "command": "vscode-coding-tracker.openSettings",
        "title": "Open Settings",
        "category": "Coding Tracker"
      }
    ],
    "configuration": {
      "title": "Coding Tracker",
      "properties": {
        "codingTracker.apiUrl": {
          "type": "string",
          "description": "The API URL to send coding session data to",
          "default": ""
        },
        "codingTracker.apiKey": {
          "type": "string",
          "description": "The API key for authentication",
          "default": ""
        },
        "codingTracker.idleMinutes": {
          "type": "number",
          "description": "Number of minutes before considering the user idle",
          "default": 5,
          "minimum": 1
        },
        "codingTracker.batchSeconds": {
          "type": "number",
          "description": "Number of seconds to accumulate before sending a batch",
          "default": 300,
          "minimum": 60
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.102.0",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  },
  "dependencies": {
    "node-fetch": "^2.7.0",
    "@types/node-fetch": "^2.6.4"
  }
}
