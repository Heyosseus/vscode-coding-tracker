{
  "name": "laravel-coding-time-tracker",
  "displayName": "Laravel Coding Time Tracker",
  "description": "A VS Code extension that tracks coding session time and syncs with a Laravel API backend.",
  "publisher": "RatiRukhadze",
  "version": "0.0.3",
  "license": "MIT",
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "icon": "/assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Heyosseus/vscode-coding-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/Heyosseus/vscode-coding-tracker/issues"
  },
  "homepage": "https://github.com/Heyosseus/vscode-coding-tracker#readme",
  "keywords": [
    "time tracking",
    "productivity",
    "coding time",
    "session tracking",
    "laravel",
    "api",
    "statistics"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "laravel-coding-time-tracker.showStats",
        "title": "Show Coding Statistics",
        "category": "Laravel Coding Tracker"
      },
      {
        "command": "laravel-coding-time-tracker.resetStats",
        "title": "Reset Local Statistics",
        "category": "Laravel Coding Tracker"
      },
      {
        "command": "laravel-coding-time-tracker.openSettings",
        "title": "Open Settings",
        "category": "Laravel Coding Tracker"
      }
    ],
    "configuration": {
      "title": "Coding Tracker",
      "properties": {
        "codingTracker.apiUrl": {
          "type": "string",
          "description": "The API URL to send coding session data to",
          "default": ""
        },
        "codingTracker.apiKey": {
          "type": "string",
          "description": "The API key for authentication",
          "default": ""
        },
        "codingTracker.idleMinutes": {
          "type": "number",
          "description": "Number of minutes before considering the user idle",
          "default": 5,
          "minimum": 1
        },
        "codingTracker.batchSeconds": {
          "type": "number",
          "description": "Number of seconds to accumulate before sending a batch",
          "default": 300,
          "minimum": 60
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "eslint": "^9.36.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.102.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@types/node-fetch": "^2.6.4",
    "node-fetch": "^2.7.0"
  }
}
